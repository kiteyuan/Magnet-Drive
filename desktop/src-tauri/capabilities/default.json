{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability; allow remote site API access if needed",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://mybt.kiteyuan.info",
      "https://mybt.kiteyuan.info/*",
      "https://*.kiteyuan.info",
      "https://*.kiteyuan.info/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
